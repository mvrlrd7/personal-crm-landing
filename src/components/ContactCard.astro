---
// Sample contact card with a Mondrian color column on the right.
// "hero": responsive card from the first screen; "compact": smaller desktop card from the final section.
interface Props {
  date: string;
  name: string;
  meta: string;
  note: string;
  /** Background classes of the color column cells, top to bottom */
  colors: string[];
  /** grid-rows-* classes for the color column */
  rows: string;
  size?: "hero" | "compact";
  class?: string;
}
const { date, name, meta, note, colors, rows, size = "hero", class: className } = Astro.props;
const hero = size === "hero";
---

<div
  class:list={[
    "grid gap-0.75 border-3 border-ink bg-ink",
    hero
      ? "grid-cols-[minmax(0,1fr)_--spacing(16)] lg:grid-cols-[minmax(0,1fr)_--spacing(24)]"
      : "grid-cols-[minmax(0,1fr)_--spacing(10)]",
    className,
  ]}
>
  <div class:list={["bg-paper", hero ? "px-4.5 pt-4.5 pb-5 lg:px-7 lg:pt-7 lg:pb-8" : "p-4.5"]}>
    <p
      class:list={[
        "leading-none font-medium tracking-date uppercase",
        hero ? "text-11 lg:text-12" : "text-11",
      ]}
    >
      {date}
    </p>
    <p
      class:list={[
        "font-medium tracking-name",
        hero ? "mt-4 text-27 leading-none lg:mt-6 lg:text-36" : "mt-3.5 text-22 leading-card-name",
      ]}
    >
      {name}
    </p>
    <p
      class:list={[
        "leading-auto tracking-meta uppercase",
        hero ? "mt-2.5 text-12 lg:mt-3 lg:text-13" : "mt-2.5 text-12",
      ]}
    >
      {meta}
    </p>
    <p
      class:list={[
        "border-t border-ink leading-note",
        hero ? "mt-4.5 pt-4 text-16 lg:mt-7 lg:pt-5 lg:text-18" : "mt-4 pt-3.5 text-15",
      ]}
    >
      {note}
    </p>
  </div>
  <div class:list={["grid gap-0.75", rows]} aria-hidden="true">
    {colors.map((color) => <span class={color}></span>)}
  </div>
</div>
