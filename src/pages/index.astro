---
import Layout from "../layouts/Layout.astro";
import ContactCard from "../components/ContactCard.astro";
import CtaBlock from "../components/CtaBlock.astro";
import Marker from "../components/Marker.astro";
import MondrianGrid from "../components/MondrianGrid.astro";
import SectionLabel from "../components/SectionLabel.astro";
import { APP_URL } from "../config";

const title = "Личная CRM — адресная книга с заметками о каждом знакомом";
const description =
  "Кто это, откуда знакомы и о чём договорились — в одной карточке. Находите человека за секунду, с телефона или компьютера.";

// Shared class strings
const section = "px-6 pb-12 lg:px-12 lg:pb-22";
const sectionRule = "border-t-2 border-ink pt-5 lg:pt-7";
const sideBySide = "lg:flex lg:flex-wrap lg:gap-x-16 lg:gap-y-8";
const narrowColumn = "lg:min-w-0 lg:flex-[5_1_--spacing(90)]";
const wideColumn = "lg:min-w-0 lg:flex-[7_1_--spacing(120)]";
// Same columns for blocks with a 3px frame: the design measures the basis without the frame (+6px)
const narrowFramedColumn = "lg:min-w-0 lg:flex-[5_1_--spacing(91.5)]";
const wideFramedColumn = "lg:min-w-0 lg:flex-[7_1_--spacing(121.5)]";
const h2 =
  "mt-3.5 text-32 leading-heading font-bold tracking-heading text-pretty lg:mt-5 lg:text-52 lg:leading-none";

const problems = [
  {
    color: "bg-blue",
    text: "Контакты разбросаны по телефону, мессенджерам и почте. Чтобы найти человека, сначала вспоминаете, где переписывались.",
  },
  {
    color: "bg-yellow",
    text: "Через полгода в телефоне «Андрей Конференция», и ни слова о том, кто он и о чём говорили.",
  },
  {
    color: "bg-red",
    text: "Договорённости забываются. Вспоминаете о них, когда напоминать о себе уже неловко.",
  },
];

const steps = [
  // The first step has no balanced wrapping in the design
  { color: "bg-yellow text-ink", title: "Добавьте человека", text: "Имя, телефон, почта, откуда знакомы.", pretty: false },
  {
    color: "bg-red text-paper",
    title: "Запишите разговор",
    text: "После встречи или звонка добавьте пару строк в карточку: о чём говорили, что обещали.",
    pretty: true,
  },
  { color: "bg-blue text-paper", title: "Найдите за секунду", text: "Введите имя, и перед вами вся история общения.", pretty: true },
];

const features = [
  { color: "bg-paper", title: "Карточка человека", text: "Кто это, откуда знакомы, телефон и почта." },
  { color: "bg-paper", title: "Заметки о разговорах", text: "Вся история общения хранится внутри карточки." },
  { color: "bg-paper", title: "Мгновенный поиск", text: "Нужного человека находите по имени." },
  { color: "bg-yellow", title: "Телефон и компьютер", text: "На обоих устройствах одни и те же данные." },
];

const results = [
  { accent: false, text: "Вы помните контекст каждого знакомства, даже спустя годы." },
  { accent: false, text: "Возвращаетесь к договорённостям вовремя, а не тогда, когда уже поздно." },
  { accent: false, text: "Приходите на встречу, зная, о чём говорили в прошлый раз." },
  { accent: true, text: "Люди замечают, что вы их помните, и это укрепляет отношения." },
];

const audience = [
  {
    color: "bg-blue",
    title: "Предприниматели и те, кто много нетворкит",
    text: "Десятки новых знакомств в месяц, и каждое может пригодиться.",
  },
  { color: "bg-yellow", title: "Фрилансеры и консультанты", text: "Клиенты, заказчики и рекомендатели в одном месте." },
  { color: "bg-red", title: "Те, кто ищет работу или меняет сферу", text: "Помните, кто обещал познакомить и с кем." },
];

const andrey = {
  date: "Карточка · 03.2026",
  name: "Андрей Соколов",
  meta: "Product Camp · дизайн‑директор",
  note: "Обещал познакомить с командой из Казани. Напомнить в апреле.",
};

const sasha = {
  date: "Карточка · 11.2025",
  name: "Саша Грей",
  meta: "Бывшая коллега · продакт",
  note: "Обсуждали переход в продукт. Прислать вакансию до пятницы.",
  colors: ["bg-yellow", "bg-paper", "bg-blue"],
  rows: "grid-rows-[1fr_2fr_1fr]",
};

const finalCards = [
  {
    ...andrey,
    colors: ["bg-blue", "bg-paper", "bg-yellow", "bg-red"],
    rows: "grid-rows-[2fr_1fr_--spacing(7)_1.4fr]",
  },
  sasha,
  {
    date: "Карточка · 05.2026",
    name: "Игорь Петров",
    meta: "Клиент · по рекомендации Анны",
    note: "Нужен сайт для студии. Созвониться 14 мая, обсудить бюджет.",
    colors: ["bg-red", "bg-paper", "bg-yellow"],
    rows: "grid-rows-[--spacing(7)_1.6fr_1fr]",
  },
];
---

<Layout title={title} description={description}>
  <!-- 01 Hero -->
  <section class="px-6 pb-10 lg:px-12 lg:pb-18">
    <header
      class="flex h-15.5 items-center justify-between border-b-2 border-ink text-14 leading-none font-semibold tracking-button uppercase lg:h-19.5 lg:text-15"
    >
      <span class="flex items-center gap-2.5 whitespace-nowrap lg:gap-3">
        <Marker class="size-3 bg-red lg:size-3.5" />Личная CRM
      </span>
      <a
        href={APP_URL}
        class="font-medium hover:opacity-85 focus-visible:outline-3 focus-visible:outline-offset-3 focus-visible:outline-blue"
        >Войти</a
      >
    </header>

    <!-- Mobile: one column, card between lead and CTA. Desktop: text + CTA left, card right. -->
    <div class="flex flex-col lg:mt-12 lg:flex-row lg:flex-wrap lg:items-end lg:gap-x-16 lg:gap-y-12">
      <div class:list={["contents lg:block", wideColumn]}>
        <SectionLabel number="01" text="Адресная книга с памятью" class="mt-5 lg:mt-0" />
        <h1
          class="mt-3.5 text-41 leading-none font-bold tracking-heading text-pretty lg:mt-5 lg:text-76 lg:leading-display lg:tracking-display"
        >
          Вы знаете больше людей, чем способны удержать в&nbsp;голове.
        </h1>
        <p class="mt-4.5 pl-12 text-15 leading-body text-pretty lg:mt-7 lg:max-w-lead lg:pl-16 lg:text-19">
          Адресная книга, которая помнит, о чём вы говорили. Кто это, откуда знакомы и о чём договорились — в одной
          карточке.
        </p>
        <CtaBlock class="order-3 lg:mt-10 lg:ml-16 lg:max-w-cta" />
      </div>
      <ContactCard
        {...andrey}
        colors={["bg-blue", "bg-paper", "bg-yellow", "bg-red"]}
        rows="grid-rows-[2fr_1fr_--spacing(7)_1.4fr] lg:grid-rows-[2fr_1fr_--spacing(9)_1.4fr]"
        class:list={["order-2 mt-7 mb-6 lg:m-0", narrowFramedColumn]}
      />
    </div>
  </section>

  <!-- 02 Problem -->
  <section class={section}>
    <div class:list={[sectionRule, sideBySide]}>
      <div class={narrowColumn}>
        <SectionLabel number="02" text="Проблема" />
        <h2 class:list={[h2, "mb-7 lg:mb-0"]}>Знакомых всё больше, а&nbsp;помнить о&nbsp;них всё труднее</h2>
      </div>
      <ul class:list={["flex flex-col lg:mt-13", wideColumn]}>
        {
          problems.map((item) => (
            <li class="grid grid-cols-[--spacing(12)_1fr] border-t border-ink py-4.5 last:border-b lg:grid-cols-[--spacing(14)_1fr] lg:py-6">
              <Marker class:list={["mt-1.25 size-3.5 lg:mt-1.5 lg:size-4", item.color]} />
              <span class="text-16 leading-body text-pretty lg:text-19">{item.text}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- 03 How it works -->
  <section class={section}>
    <div class={sectionRule}>
      <SectionLabel number="03" text="Как это работает" />
      <h2 class:list={[h2, "mb-7 lg:mb-10 lg:max-w-heading"]}>Три шага. Без настройки и&nbsp;обучения</h2>
      <MondrianGrid as="ol" class="grid grid-cols-[--spacing(16)_1fr] lg:grid-cols-3">
        {
          steps.map((step, index) => (
            <li class="contents lg:grid lg:grid-rows-[--spacing(24)_1fr] lg:gap-0.75">
              <span
                class:list={[
                  "flex items-start justify-center pt-4.5 text-28 leading-none font-bold lg:items-end lg:justify-start lg:px-6 lg:pt-0 lg:pb-4 lg:text-44",
                  step.color,
                ]}
              >
                {index + 1}
              </span>
              <div class="bg-paper p-4.5 lg:p-6">
                <h3 class="text-18 leading-title font-semibold lg:text-22">{step.title}</h3>
                <p class:list={["mt-2 text-15 leading-body lg:mt-2.5 lg:text-17", step.pretty && "text-pretty"]}>{step.text}</p>
              </div>
            </li>
          ))
        }
      </MondrianGrid>
    </div>
  </section>

  <!-- 04 Features -->
  <section class={section}>
    <div class={sectionRule}>
      <SectionLabel number="04" text="Возможности" />
      <h2 class:list={[h2, "mb-7 lg:mb-10 lg:max-w-heading"]}>Всё, что нужно, и&nbsp;ничего лишнего</h2>
      <MondrianGrid as="ul" class="grid grid-cols-2 lg:grid-cols-[minmax(0,1.2fr)_minmax(0,1fr)_minmax(0,1fr)]">
        <li
          class="col-span-2 bg-blue px-4.5 py-5 text-paper lg:col-span-1 lg:row-span-2 lg:flex lg:min-h-79 lg:flex-col lg:justify-end lg:px-6 lg:py-7"
        >
          <h3 class="text-18 leading-title font-semibold lg:text-30 lg:leading-tight lg:tracking-name">Один список</h3>
          <p class="mt-2 text-15 leading-note lg:mt-3 lg:text-18">Все, кого вы знаете лично, собраны в одном месте.</p>
        </li>
        {
          features.map((feature) => (
            <li class:list={["px-4 py-4.5 lg:px-6 lg:py-7", feature.color]}>
              <h3 class="text-16 leading-title font-semibold lg:text-20">{feature.title}</h3>
              <p class="mt-2 text-14 leading-note lg:mt-2.5 lg:text-16">{feature.text}</p>
            </li>
          ))
        }
      </MondrianGrid>
    </div>
  </section>

  <!-- 05 Result -->
  <section class={section}>
    <div class:list={[sectionRule, sideBySide]}>
      <div class={narrowColumn}>
        <SectionLabel number="05" text="Результат" />
        <h2 class:list={[h2, "mb-7 lg:mb-0"]}>Что изменится</h2>
      </div>
      <MondrianGrid as="ul" class:list={["flex flex-col lg:mt-13 lg:grid lg:grid-cols-2", wideFramedColumn]}>
        {
          results.map((item) => (
            <li
              class:list={[
                "grid grid-cols-[--spacing(10)_1fr] gap-2 py-4.5 pr-4.5 lg:flex lg:flex-col lg:gap-5 lg:p-6",
                item.accent ? "bg-red text-paper" : "bg-paper",
              ]}
            >
              <span
                class="text-center text-18 leading-snug font-semibold lg:text-left lg:text-22 lg:leading-none"
                aria-hidden="true"
              >
                →
              </span>
              <span class:list={["text-16 leading-note text-pretty lg:text-18", item.accent && "font-medium"]}>
                {item.text}
              </span>
            </li>
          ))
        }
      </MondrianGrid>
    </div>
  </section>

  <!-- 06 Audience -->
  <section class={section}>
    <div class={sectionRule}>
      <SectionLabel number="06" text="Аудитория" />
      <h2 class:list={[h2, "mb-7 lg:mb-10"]}>Для кого</h2>
      <ul class="flex flex-col lg:grid lg:grid-cols-3 lg:gap-x-10">
        {
          audience.map((item) => (
            <li class="grid grid-cols-[--spacing(12)_1fr] border-t border-ink py-4.5 lg:grid-cols-[--spacing(10)_1fr] lg:py-6">
              <Marker class:list={["mt-1 size-3.5 lg:mt-1.25 lg:size-4", item.color]} />
              <div>
                <h3 class="text-17 leading-snug font-semibold lg:text-20">{item.title}</h3>
                <p class="mt-1.5 text-15 leading-body lg:mt-2 lg:text-17">{item.text}</p>
              </div>
            </li>
          ))
        }
      </ul>
      <p
        class="grid grid-cols-[--spacing(12)_1fr] border-y border-ink py-5 lg:grid-cols-[--spacing(10)_1fr] lg:py-7"
      >
        <Marker class="mt-1.5 size-3.5 bg-ink lg:mt-3.5 lg:size-4" />
        <span
          class="text-22 leading-closing font-bold tracking-name text-pretty lg:text-36 lg:leading-tight lg:tracking-closing"
        >
          Все, у кого людей больше, чем помещается в&nbsp;голове.
        </span>
      </p>
    </div>
  </section>

  <!-- 07 Final call. Desktop: at least as tall as the hero (855px on wide screens), cards centered in the free space -->
  <section class="px-6 pb-7 lg:flex lg:min-h-213.75 lg:flex-col lg:px-12 lg:pb-9">
    <div class="grid h-3.5 grid-cols-[3fr_1fr_2fr] border-y-2 border-ink lg:h-4.5" aria-hidden="true">
      <span class="bg-red"></span><span class="bg-yellow"></span><span class="bg-blue"></span>
    </div>
    <div class="mt-7 lg:mt-12 lg:flex lg:flex-wrap lg:items-end lg:gap-x-16 lg:gap-y-10">
      <div class={wideColumn}>
        <SectionLabel number="07" text="Начните сегодня" />
        <h2
          class="mt-3.5 text-38 leading-none font-bold tracking-heading text-pretty lg:mt-5 lg:text-68 lg:leading-display lg:tracking-display"
        >
          Приходите на встречу так, будто виделись вчера.
        </h2>
      </div>
      <div class={narrowColumn}>
        <p class="mt-4.5 mb-7 pl-12 text-16 leading-body text-pretty lg:mt-0 lg:mb-8 lg:pl-0 lg:text-19">
          Вспомните последний важный разговор и запишите его. Через полгода вы скажете себе спасибо.
        </p>
        <!-- Mobile only: one sample card above the CTA; desktop shows three cards below -->
        <ContactCard {...sasha} class="mb-6 lg:hidden" />
        <CtaBlock />
      </div>
    </div>
    <div class="hidden flex-1 flex-col justify-center pt-9 lg:flex">
      <div class="grid grid-cols-3 gap-5">
        {finalCards.map((card) => <ContactCard {...card} size="compact" />)}
      </div>
    </div>
    <footer
      class="mt-11 flex items-center justify-between border-t-2 border-ink pt-4 text-11 leading-none font-medium tracking-micro uppercase lg:mt-14 lg:pt-5 lg:text-12"
    >
      <span class="flex items-center gap-2 lg:gap-2.5"><Marker class="size-2.5 bg-red lg:size-3" />Личная CRM</span>
      <span>© 2026</span>
    </footer>
  </section>
</Layout>
